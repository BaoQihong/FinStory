{
  "name": "finstory",
  "version": "0.6.0",
  "private": true,
  "description": "Seshat — financial storytelling publication (FinStory repository)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/data/transforms.test.ts scripts/studio/pipeline.test.ts scripts/studio/brief.test.ts scripts/publishing/publishing.test.ts scripts/publishing/home.test.ts scripts/studio/polish.test.ts",
    "data:fetch": "node scripts/data/fetch-fred.mjs",
    "data:validate": "node scripts/data/validate-fixtures.ts",
    "verify": "npm run test && npm run data:validate && npm run lint && npm run typecheck && npm run build",
    "studio:check-registry": "node scripts/studio/check-registry.mjs",
    "studio:editor": "node scripts/setup/create-editor.mjs",
    "studio:generate": "node scripts/studio/generate-draft.ts",
    "publish:check": "node scripts/publishing/publish-check.ts",
    "publish:route-check": "node scripts/publishing/public-route-check.ts",
    "publish:home-check": "node scripts/publishing/home-check.ts",
    "editorial:eval": "node scripts/studio/editorial-eval.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
