{
  "name": "finstory",
  "version": "0.2.0",
  "private": true,
  "description": "Seshat — financial storytelling publication (FinStory repository)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/data/transforms.test.ts",
    "data:fetch": "node scripts/data/fetch-fred.mjs",
    "data:validate": "node scripts/data/validate-fixtures.ts",
    "verify": "npm run test && npm run data:validate && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.11.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
