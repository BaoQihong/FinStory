# FinStory — environment variable template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Names verified against Supabase's current API-key system and the
# OpenAI-compatible client convention used by Arli AI.

# ── Supabase ────────────────────────────────────────────────
# Project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://gmcllutljmotushrsqka.supabase.co

# Publishable key (new API key system, safe for client use).
# Legacy projects use the anon key instead — same variable works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (server-side ONLY — never expose to the browser).
# Legacy projects: service_role key.
SUPABASE_SECRET_KEY=

# Postgres connection string (Dashboard → Project Settings → Database).
# Pooler (port 6543) is recommended for serverless; direct is port 5432.
# Format: postgresql://postgres.gmcllutljmotushrsqka:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase CLI personal access token (optional; lets the CLI run
# non-interactively). Dashboard → Account → Access Tokens.
# SUPABASE_ACCESS_TOKEN=

# ── Arli AI (OpenAI-compatible API, Qwen models) ────────────
# Key: arliai.com → Account → API Keys. List models with:
#   node scripts/verify/connectivity.mjs --only=arli --list-models
ARLI_API_KEY=
ARLI_BASE_URL=https://api.arliai.com/v1
ARLI_MODEL=
# Optional interim model roles (Phase 3D.1a, D-058). Each falls back to
# ARLI_MODEL when unset or empty; leave both unset for the Qwen-only default.
#   analytical: plan, select, synthesize, macro_analytics, outlook, review,
#               repair, brief, fix      editorial: story, polish
# Exact Arli ids (case as in the live catalog), e.g.:
# ARLI_ANALYTICAL_MODEL=DeepSeek-V4.1-Flash-1017
# ARLI_EDITORIAL_MODEL=MiMo-V2.6-Flash-MOPD

# ── Phase 2B research & data providers (server-side only) ───
# Web search — Tavily (https://app.tavily.com, free tier 1,000 credits/month). D-024
TAVILY_API_KEY=
# FRED API — series search + observations (https://fredaccount.stlouisfed.org/apikeys, free). D-025
FRED_API_KEY=
# Tiingo — end-of-day equity/ETF prices (https://www.tiingo.com, free tier = internal use only). D-025
TIINGO_API_KEY=
# Optional: US EIA Open Data (https://www.eia.gov/opendata/register.php, free).
# Enables weekly crude inventories/production; without it oil stories degrade gracefully.
# EIA_API_KEY=

# ── Editorial studio login (local setup scripts only; NOT needed on Vercel) ──
# Used by scripts/setup/create-editor.mjs to create/verify the single editor.
EDITOR_EMAIL=
EDITOR_PASSWORD=

# ── Vercel ──────────────────────────────────────────────────
# VERCEL_OIDC_TOKEN is written automatically by `vercel link` /
# `vercel env pull`. Do not set it by hand.

# ── Site (optional locally; set automatically on Vercel) ────
# NEXT_PUBLIC_SITE_URL=
