# FinStory — environment variable template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Names verified against Supabase's current API-key system and the
# OpenAI-compatible client convention used by Arli AI.

# ── Supabase ────────────────────────────────────────────────
# Project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://gmcllutljmotushrsqka.supabase.co

# Publishable key (new API key system, safe for client use).
# Legacy projects use the anon key instead — same variable works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (server-side ONLY — never expose to the browser).
# Legacy projects: service_role key.
SUPABASE_SECRET_KEY=

# Postgres connection string (Dashboard → Project Settings → Database).
# Pooler (port 6543) is recommended for serverless; direct is port 5432.
# Format: postgresql://postgres.gmcllutljmotushrsqka:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase CLI personal access token (optional; lets the CLI run
# non-interactively). Dashboard → Account → Access Tokens.
# SUPABASE_ACCESS_TOKEN=

# ── Arli AI (OpenAI-compatible API, Qwen models) ────────────
# Key: arliai.com → Account → API Keys. List models with:
#   node scripts/verify/connectivity.mjs --only=arli --list-models
ARLI_API_KEY=
ARLI_BASE_URL=https://api.arliai.com/v1
ARLI_MODEL=

# ── Vercel ──────────────────────────────────────────────────
# VERCEL_OIDC_TOKEN is written automatically by `vercel link` /
# `vercel env pull`. Do not set it by hand.

# ── Site (optional locally; set automatically on Vercel) ────
# NEXT_PUBLIC_SITE_URL=
